+//! Shared data-only companions: static session choice, explicit local actions, no timers or models.
+
+use crossterm::event::{KeyCode, KeyEvent, MouseButton, MouseEvent, MouseEventKind};
+use ratatui::buffer::Buffer;
+use ratatui::layout::{Position, Rect};
+use ratatui::style::Stylize;
+use ratatui::text::Line;
+use ratatui::widgets::Widget;
+use serde_json::Value;
+use std::sync::LazyLock;
+
+static ASSETS: LazyLock<Value> = LazyLock::new(|| {
+    serde_json::from_str(include_str!("assets/sprites.json")).expect("valid bundled mascot data")
+});
+const AFFORDANCE_ROWS: u16 = 4; // three bubble rows and an unconditional blank gap
+pub(crate) fn static_required_height() -> u16 {
+    ASSETS["sprites"]
+        .as_array()
+        .expect("mascot list")
+        .iter()
+        .map(|sprite| {
+            sprite["frames"][0]
+                .as_array()
+                .map_or(0, |frame| frame.len() as u16)
+        })
+        .max()
+        .unwrap_or(4)
+        + AFFORDANCE_ROWS
+        + 1
+}
+
+pub(crate) fn affordance_rows() -> u16 {
+    AFFORDANCE_ROWS
+}
+
+#[derive(Default)]
+pub(crate) struct Mascot {
+    session: String,
+    index: usize,
+    area: Option<Rect>,
+    hover: bool,
+    focus: bool,
+    native: bool,
+    recap: String,
+    message: Option<String>,
+    pub(crate) dirty: bool,
+}
+
+impl Mascot {
+    pub(crate) fn focused(&self) -> bool {
+        self.focus && self.area.is_some()
+    }
+    pub(crate) fn clear_focus(&mut self) {
+        self.focus = false;
+        self.hover = false;
+    }
+
+    pub(crate) fn hide(&mut self) {
+        self.area = None;
+        self.focus = false;
+        self.hover = false;
+    }
+    pub(crate) fn observe(&mut self, mouse: MouseEvent) -> bool {
+        let hover = self
+            .area
+            .is_some_and(|area| area.contains(Position::new(mouse.column, mouse.row)));
+        let changed = hover != self.hover;
+        self.hover = hover;
+        self.dirty |= changed;
+        changed
+    }
+    fn poke(&mut self) {
+        let sprites = ASSETS["sprites"].as_array().expect("mascot list");
+        let action = &sprites[self.index % sprites.len()]["action"];
+        if self.native {
+            self.message = Some("Use /pets to choose your companion.".into());
+        } else {
+            match action["kind"].as_str().unwrap_or("toast") {
+                "next" => {
+                    self.index = (self.index + 1) % sprites.len();
+                    self.message = Some("Hello from a different companion! /pets".into());
+                }
+                "recap" => {
+                    self.message = Some(if self.recap.trim().is_empty() {
+                        "No recap yet: it comes after the first answer.".into()
+                    } else {
+                        self.recap.clone()
+                    })
+                }
+                "animate" => {
+                    self.message =
+                        Some("A friendly hello! Staying still while you read. /pets".into())
+                }
+                _ => self.message = Some(action["text"].as_str().unwrap_or("hi!").into()),
+            }
+        }
+        self.dirty = true;
+    }
+    pub(crate) fn mouse(&mut self, mouse: MouseEvent) -> bool {
+        self.observe(mouse);
+        if !self.hover {
+            if matches!(mouse.kind, MouseEventKind::Down(_)) {
+                self.focus = false;
+            }
+            return false;
+        }
+        if mouse.kind == MouseEventKind::Down(MouseButton::Left) && mouse.modifiers.is_empty() {
+            self.poke();
+        }
+        true
+    }
+    pub(crate) fn owns_key(&self, key: KeyEvent) -> bool {
+        self.area.is_some()
+            && key.modifiers.is_empty()
+            && (key.code == KeyCode::F(7)
+                || self.focus
+                    && matches!(key.code, KeyCode::Esc | KeyCode::Enter | KeyCode::Char(' ')))
+    }
+    pub(crate) fn key(&mut self, key: KeyEvent) -> bool {
+        if !self.owns_key(key) {
+            if self.focus {
+                self.focus = false;
+                self.dirty = true;
+            }
+            return false;
+        }
+        match key.code {
+            KeyCode::F(7) => self.focus = !self.focus,
+            KeyCode::Esc => self.focus = false,
+            _ => self.poke(),
+        }
+        self.dirty = true;
+        true
+    }
+    pub(crate) fn render(
+        &mut self,
+        area: Rect,
+        session: &str,
+        recap: &str,
+        native: bool,
+        buffer: &mut Buffer,
+    ) {
+        let sprites = ASSETS["sprites"].as_array().expect("mascot list");
+        if self.session != session {
+            self.session = session.to_owned();
+            self.index = session.bytes().fold(0usize, |hash, byte| {
+                hash.wrapping_mul(31).wrapping_add(usize::from(byte))
+            }) % sprites.len();
+            self.message = None;
+        }
+        self.area = Some(area);
+        self.native = native;
+        self.recap = recap.chars().take(800).collect();
+        let sprite = &sprites[self.index];
+        let frame = sprite["frames"][0]
+            .as_array()
+            .expect("four-row mascot frame");
+        let sprite_width = if native {
+            12
+        } else {
+            frame
+                .iter()
+                .map(|line| line.as_str().unwrap_or("").chars().count() as u16)
+                .max()
+                .unwrap_or(10)
+        };
+        let sprite_x = area.right().saturating_sub(sprite_width);
+        if !native {
+            let y = area.bottom().saturating_sub(frame.len() as u16);
+            for (row, line) in frame.iter().enumerate() {
+                Line::from(line.as_str().unwrap_or("").to_owned())
+                    .cyan()
+                    .render(Rect::new(sprite_x, y + row as u16, sprite_width, 1), buffer);
+            }
+        }
+        if let Some(message) = &self.message {
+            let width = usize::from(sprite_x.saturating_sub(area.x + 1)).max(1);
+            for (row, line) in textwrap::wrap(message, width)
+                .into_iter()
+                .take(4)
+                .enumerate()
+            {
+                Line::from(line.into_owned()).dim().render(
+                    Rect::new(
+                        area.x,
+                        area.y + AFFORDANCE_ROWS + row as u16,
+                        width as u16,
+                        1,
+                    ),
+                    buffer,
+                );
+            }
+        }
+        if self.hover || self.focus {
+            let width = area.width.min(38);
+            let label = self
+                .message
+                .as_deref()
+                .filter(|text| text.chars().count() + 4 <= usize::from(width))
+                .unwrap_or("Click / enter · /pets");
+            let text = label
+                .chars()
+                .filter(|c| !c.is_control())
+                .collect::<String>();
+            let inner = usize::from(width.saturating_sub(2));
+            for (row, line) in [
+                format!("╭{}╮", "─".repeat(inner)),
+                format!("│{text:<inner$}│"),
+                format!("╰{}╯", "─".repeat(inner)),
+            ]
+            .into_iter()
+            .enumerate()
+            {
+                crate::line_truncation::truncate_line_with_ellipsis_if_overflow(
+                    Line::from(line).dim(),
+                    usize::from(width),
+                )
+                .render(
+                    Rect::new(area.right() - width, area.y + row as u16, width, 1),
+                    buffer,
+                );
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crossterm::event::KeyModifiers;
+    fn paint(mascot: &mut Mascot, session: &str) -> Buffer {
+        let mut buffer = Buffer::empty(Rect::new(0, 0, 44, 12));
+        mascot.render(
+            Rect::new(1, 3, 43, 9),
+            session,
+            "A fictional recap.",
+            false,
+            &mut buffer,
+        );
+        buffer
+    }
+    fn symbols(buffer: &Buffer) -> String {
+        buffer.content.iter().map(|cell| cell.symbol()).collect()
+    }
+    #[test]
+    fn info_pane_mascot_is_static_session_stable_with_hover_focus_gap() {
+        let mut mascot = Mascot::default();
+        let before = paint(&mut mascot, "synthetic-session");
+        let chosen = mascot.index;
+        assert!(!symbols(&before).contains("/pets"));
+        assert_eq!(paint(&mut mascot, "synthetic-session"), before);
+        mascot.observe(MouseEvent {
+            kind: MouseEventKind::Moved,
+            column: 40,
+            row: 10,
+            modifiers: KeyModifiers::NONE,
+        });
+        let expanded = paint(&mut mascot, "synthetic-session");
+        assert!(symbols(&expanded).contains("/pets"));
+        assert_eq!(mascot.index, chosen);
+        assert!((1..44).all(|x| expanded[(x, 6)].symbol() == " ")); // bubble below row5, sprite starts row8
+        mascot.observe(MouseEvent {
+            kind: MouseEventKind::Moved,
+            column: 0,
+            row: 0,
+            modifiers: KeyModifiers::NONE,
+        });
+        assert_eq!(paint(&mut mascot, "synthetic-session"), before);
+        assert!(mascot.key(KeyEvent::new(KeyCode::F(7), KeyModifiers::NONE)));
+        assert!(symbols(&paint(&mut mascot, "synthetic-session")).contains("/pets"));
+        mascot.key(KeyEvent::new(KeyCode::Esc, KeyModifiers::NONE));
+        assert_eq!(paint(&mut mascot, "synthetic-session"), before);
+    }
+    #[test]
+    fn info_pane_mascot_actions_are_local_and_never_animate() {
+        let mut mascot = Mascot::default();
+        paint(&mut mascot, "synthetic-session");
+        for index in 0..ASSETS["sprites"].as_array().unwrap().len() {
+            mascot.index = index;
+            let kind = ASSETS["sprites"][index]["action"]["kind"].as_str().unwrap();
+            mascot.poke();
+            assert!(mascot.message.is_some());
+            if kind == "next" {
+                assert_ne!(mascot.index, index);
+            } else {
+                assert_eq!(mascot.index, index);
+            }
+            assert!(!mascot.message.as_deref().unwrap().is_empty());
+        }
+    }
+}
