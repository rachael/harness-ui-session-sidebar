diff --git a/codex-rs/tui/src/transcript_view/response_pane.rs b/codex-rs/tui/src/transcript_view/response_pane.rs
new file mode 100644
index 0000000..08cd02f
--- /dev/null
+++ b/codex-rs/tui/src/transcript_view/response_pane.rs
@@ -0,0 +1,461 @@
+//! Explicit response navigation in the optional info pane; hover never changes list layout.
+
+use super::*;
+use crate::history_cell::AgentMarkdownCell;
+use crate::history_cell::AgentMessageCell;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyModifiers;
+use crossterm::event::MouseButton;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+use ratatui::layout::Position as ScreenPosition;
+use ratatui::widgets::Block;
+use ratatui::widgets::Borders;
+use std::collections::HashSet;
+
+#[derive(Clone, Copy, Default, PartialEq, Eq)]
+enum Tab {
+    #[default]
+    Overview,
+    Responses,
+}
+
+struct Response {
+    // Retaining the displayed cell prevents a stale hit target's pointer identity from recycling.
+    cell: Arc<dyn HistoryCell>,
+    title: String,
+    summary: String,
+}
+
+#[derive(Clone, Copy)]
+enum Action {
+    Overview,
+    Responses,
+    Expand(EntryKey),
+    Jump(EntryKey),
+}
+
+#[derive(Default)]
+pub(super) struct ResponsePane {
+    area: Option<Rect>,
+    tab: Tab,
+    keyboard: bool,
+    selected: usize,
+    reveal_selected: bool,
+    offset: usize,
+    max_offset: usize,
+    expanded: HashSet<EntryKey>,
+    responses: Vec<Response>,
+    hits: Vec<(Rect, Action)>,
+    pet: Option<crate::info_pane::PanePet>,
+    mascot: crate::info_pane::mascot::Mascot,
+}
+
+impl ResponsePane {
+    pub(super) fn is_focused(&self) -> bool {
+        self.area.is_some() && (self.keyboard || self.mascot.focused())
+    }
+}
+
+fn excerpt(cell: &dyn HistoryCell) -> String {
+    // Bound the borrowed markdown source before allocating; large responses remain in history.
+    if let Some(source) = cell.copy_source() {
+        return source
+            .chars()
+            .filter(|c| !c.is_control() || *c == '\n')
+            .take(420)
+            .collect();
+    }
+    let mut excerpt = String::new();
+    let mut remaining = 420;
+    for line in cell.raw_lines() {
+        for character in line
+            .spans
+            .iter()
+            .flat_map(|span| span.content.chars())
+            .chain(std::iter::once('\n'))
+            .filter(|c| !c.is_control() || *c == '\n')
+        {
+            if remaining == 0 {
+                return excerpt;
+            }
+            excerpt.push(character);
+            remaining -= 1;
+        }
+    }
+    excerpt
+}
+
+impl TranscriptView {
+    pub(crate) fn render_info_pane(
+        &mut self,
+        pane: Option<&crate::info_pane::Pane>,
+        pet: Option<crate::info_pane::PanePet>,
+        area: Rect,
+        buffer: &mut Buffer,
+        cells: &[Arc<dyn HistoryCell>],
+    ) {
+        let navigation = &mut self.response_pane;
+        navigation.hits.clear();
+        navigation.pet = pet;
+        navigation.area = pane
+            .filter(|_| area.width >= 16 && area.height >= 4)
+            .map(|_| area);
+        let Some(pane) = pane.filter(|_| navigation.area.is_some()) else {
+            navigation.keyboard = false;
+            navigation.pet = None;
+            navigation.mascot.hide();
+            return;
+        };
+        navigation.responses = cells
+            .iter()
+            .rev()
+            .filter(|cell| {
+                cell.as_any().is::<AgentMarkdownCell>()
+                    || (cell.as_any().is::<AgentMessageCell>() && !cell.is_stream_continuation())
+            })
+            .filter_map(|cell| {
+                let summary = excerpt(cell.as_ref());
+                let title = summary
+                    .lines()
+                    .map(str::trim)
+                    .find(|line| !line.is_empty())?
+                    .to_owned();
+                Some(Response {
+                    cell: Arc::clone(cell),
+                    title,
+                    summary,
+                })
+            })
+            .collect();
+        navigation.expanded.retain(|key| {
+            navigation
+                .responses
+                .iter()
+                .any(|response| EntryKey::cell(&response.cell) == *key)
+        });
+        navigation.selected = navigation
+            .selected
+            .min(navigation.responses.len().saturating_sub(1));
+        Clear.render(area, buffer);
+        let block = Block::default().borders(Borders::LEFT).title(" Info ");
+        let mut inner = block.inner(area);
+        block.render(area, buffer);
+        let (session, recap, native_selected) = pane.mascot_context();
+        let mascot_area = navigation.pet.as_ref().map(|pet| pet.area).or_else(|| {
+            (!native_selected)
+                .then(|| {
+                    crate::info_pane::pet_footer_area(
+                        area,
+                        crate::info_pane::mascot::static_required_height(),
+                    )
+                })
+                .flatten()
+        });
+        if let Some(footer) = mascot_area {
+            // The bubble gap and companion never change list geometry on hover/focus.
+            inner.height = footer.y.saturating_sub(inner.y);
+            navigation
+                .mascot
+                .render(footer, session, recap, navigation.pet.is_some(), buffer);
+        } else {
+            navigation.mascot.hide();
+        }
+
+        let overview = Rect::new(inner.x, inner.y, inner.width.min(11), 1);
+        let responses = Rect::new(
+            overview.right(),
+            inner.y,
+            inner.width.saturating_sub(overview.width),
+            1,
+        );
+        Line::from("Overview")
+            .style(if navigation.tab == Tab::Overview {
+                crate::style::history_prompt_style()
+            } else {
+                Default::default()
+            })
+            .render(overview, buffer);
+        Line::from(format!("Responses {}", navigation.responses.len()))
+            .style(if navigation.tab == Tab::Responses {
+                crate::style::history_prompt_style()
+            } else {
+                Default::default()
+            })
+            .render(responses, buffer);
+        navigation
+            .hits
+            .extend([(overview, Action::Overview), (responses, Action::Responses)]);
+        let body = Rect::new(
+            inner.x,
+            inner.y + 2,
+            inner.width,
+            inner.height.saturating_sub(3),
+        );
+        let footer = Rect::new(inner.x, inner.bottom().saturating_sub(1), inner.width, 1);
+        Line::from("F6 tabs · F7 pet · +/- summary")
+            .dim()
+            .render(footer, buffer);
+        if navigation.tab == Tab::Overview {
+            pane.render_content(body, buffer);
+            return;
+        }
+        let mut lines = Vec::new();
+        if navigation.responses.is_empty() {
+            lines.push((Line::from("No retained responses yet").dim(), None));
+        }
+        let mut selected_row = 0;
+        for (index, response) in navigation.responses.iter().enumerate() {
+            if index == navigation.selected {
+                selected_row = lines.len();
+            }
+            let key = EntryKey::cell(&response.cell);
+            let open = navigation.expanded.contains(&key);
+            let prefix = if open { "[-] " } else { "[+] " };
+            let line = crate::line_truncation::truncate_line_with_ellipsis_if_overflow(
+                Line::from(format!("{prefix}{}", response.title)),
+                usize::from(body.width),
+            );
+            let line = if navigation.keyboard && index == navigation.selected {
+                line.reversed()
+            } else {
+                line
+            };
+            lines.push((line, Some((key, true))));
+            if open {
+                let summary = response
+                    .summary
+                    .split_whitespace()
+                    .collect::<Vec<_>>()
+                    .join(" ");
+                let summary = format!("Summary: {summary}");
+                for line in
+                    textwrap::wrap(&summary, usize::from(body.width.saturating_sub(2)).max(1))
+                        .into_iter()
+                        .take(4)
+                {
+                    lines.push((Line::from(format!("  {line}")).dim(), Some((key, false))));
+                }
+            }
+        }
+        if navigation.reveal_selected {
+            if selected_row < navigation.offset {
+                navigation.offset = selected_row;
+            }
+            if selected_row >= navigation.offset + usize::from(body.height) {
+                navigation.offset =
+                    selected_row.saturating_sub(usize::from(body.height.saturating_sub(1)));
+            }
+            navigation.reveal_selected = false;
+        }
+        navigation.max_offset = lines.len().saturating_sub(usize::from(body.height));
+        navigation.offset = navigation.offset.min(navigation.max_offset);
+        for (row, (line, target)) in lines
+            .into_iter()
+            .skip(navigation.offset)
+            .take(usize::from(body.height))
+            .enumerate()
+        {
+            let row = Rect::new(body.x, body.y + row as u16, body.width, 1);
+            line.render(row, buffer);
+            if let Some((key, toggle)) = target {
+                let expand_width = if toggle { row.width.min(3) } else { 0 };
+                if expand_width > 0 {
+                    navigation.hits.push((
+                        Rect::new(row.x, row.y, expand_width, 1),
+                        Action::Expand(key),
+                    ));
+                }
+                navigation.hits.push((
+                    Rect::new(row.x + expand_width, row.y, row.width - expand_width, 1),
+                    Action::Jump(key),
+                ));
+            }
+        }
+    }
+
+    fn apply_response_pane_action(&mut self, action: Action, cells: &[Arc<dyn HistoryCell>]) {
+        match action {
+            Action::Overview => {
+                self.response_pane.tab = Tab::Overview;
+                self.response_pane.offset = 0;
+            }
+            Action::Responses => {
+                self.response_pane.tab = Tab::Responses;
+                self.response_pane.offset = 0;
+            }
+            Action::Expand(key) => {
+                if !self.response_pane.expanded.remove(&key) {
+                    self.response_pane.expanded.insert(key);
+                }
+            }
+            Action::Jump(key) => {
+                if let Some(index) = cells.iter().position(|cell| EntryKey::cell(cell) == key) {
+                    self.end_selection(cells);
+                    self.cancel_search();
+                    self.clear_activity_focus();
+                    self.jump_to_entry(cells, index);
+                }
+            }
+        }
+    }
+
+    pub(crate) fn info_pane_pet_draw(&self) -> Option<crate::pets::AmbientPetDraw> {
+        self.response_pane.pet.as_ref().map(|pet| pet.draw.clone())
+    }
+
+    pub(crate) fn observe_info_pane_mascot_mouse(&mut self, mouse: MouseEvent) -> bool {
+        self.response_pane.mascot.observe(mouse)
+    }
+
+    pub(crate) fn take_info_pane_redraw(&mut self) -> bool {
+        std::mem::take(&mut self.response_pane.mascot.dirty)
+    }
+
+    pub(crate) fn clear_info_pane_focus(&mut self) {
+        self.response_pane.keyboard = false;
+        self.response_pane.mascot.clear_focus();
+    }
+
+    pub(crate) fn handle_info_pane_mouse(
+        &mut self,
+        mouse: MouseEvent,
+        cells: &[Arc<dyn HistoryCell>],
+    ) -> bool {
+        if self.response_pane.mascot.mouse(mouse) {
+            return true;
+        }
+        if !self
+            .response_pane
+            .area
+            .is_some_and(|area| area.contains(ScreenPosition::new(mouse.column, mouse.row)))
+        {
+            if matches!(mouse.kind, MouseEventKind::Down(_)) {
+                self.response_pane.keyboard = false;
+            }
+            return false;
+        }
+        match mouse.kind {
+            MouseEventKind::Down(MouseButton::Left) if mouse.modifiers.is_empty() => {
+                let action = self
+                    .response_pane
+                    .hits
+                    .iter()
+                    .find(|(area, _)| area.contains(ScreenPosition::new(mouse.column, mouse.row)))
+                    .map(|(_, action)| *action);
+                self.response_pane.keyboard = false;
+                if let Some(action) = action {
+                    self.apply_response_pane_action(action, cells);
+                }
+            }
+            MouseEventKind::ScrollUp => {
+                self.response_pane.offset = self.response_pane.offset.saturating_sub(3)
+            }
+            MouseEventKind::ScrollDown => {
+                self.response_pane.offset = self
+                    .response_pane
+                    .offset
+                    .saturating_add(3)
+                    .min(self.response_pane.max_offset)
+            }
+            _ => {}
+        }
+        true
+    }
+
+    pub(super) fn response_pane_owns_key(&self, key: KeyEvent) -> bool {
+        if self.response_pane.mascot.owns_key(key) {
+            return true;
+        }
+        self.response_pane.area.is_some()
+            && key.modifiers.is_empty()
+            && (key.code == KeyCode::F(6)
+                || self.response_pane.keyboard
+                    && matches!(
+                        key.code,
+                        KeyCode::Esc
+                            | KeyCode::Enter
+                            | KeyCode::Char(' ')
+                            | KeyCode::Up
+                            | KeyCode::Down
+                            | KeyCode::PageUp
+                            | KeyCode::PageDown
+                    ))
+    }
+
+    pub(super) fn handle_response_pane_key(
+        &mut self,
+        key: KeyEvent,
+        cells: &[Arc<dyn HistoryCell>],
+    ) -> Option<ViewAction> {
+        if self.response_pane.mascot.key(key) {
+            return Some(ViewAction::Changed);
+        }
+        if key.modifiers != KeyModifiers::NONE || self.response_pane.area.is_none() {
+            return None;
+        }
+        if key.code == KeyCode::F(6) {
+            self.response_pane.keyboard = !self.response_pane.keyboard;
+            self.response_pane.tab = if self.response_pane.keyboard {
+                Tab::Responses
+            } else {
+                Tab::Overview
+            };
+            self.response_pane.offset = 0;
+            return Some(ViewAction::Changed);
+        }
+        if !self.response_pane.keyboard {
+            return None;
+        }
+        match key.code {
+            KeyCode::Esc => self.response_pane.keyboard = false,
+            KeyCode::Enter | KeyCode::Char(' ') => {
+                let response = self
+                    .response_pane
+                    .responses
+                    .get(self.response_pane.selected)?;
+                let target = EntryKey::cell(&response.cell);
+                self.apply_response_pane_action(
+                    if key.code == KeyCode::Enter {
+                        Action::Jump(target)
+                    } else {
+                        Action::Expand(target)
+                    },
+                    cells,
+                );
+            }
+            KeyCode::Up => {
+                self.response_pane.selected = self.response_pane.selected.saturating_sub(1);
+                self.response_pane.reveal_selected = true;
+            }
+            KeyCode::Down => {
+                self.response_pane.selected = self
+                    .response_pane
+                    .selected
+                    .saturating_add(1)
+                    .min(self.response_pane.responses.len().saturating_sub(1));
+                self.response_pane.reveal_selected = true;
+            }
+            KeyCode::PageUp => {
+                self.response_pane.offset = self.response_pane.offset.saturating_sub(5)
+            }
+            KeyCode::PageDown => {
+                self.response_pane.offset = self
+                    .response_pane
+                    .offset
+                    .saturating_add(5)
+                    .min(self.response_pane.max_offset)
+            }
+            _ => {
+                self.response_pane.keyboard = false;
+                return None;
+            }
+        }
+        Some(ViewAction::Changed)
+    }
+}
+
+#[cfg(test)]
+#[path = "response_pane_tests.rs"]
+mod tests;
diff --git a/codex-rs/tui/src/transcript_view/response_pane_tests.rs b/codex-rs/tui/src/transcript_view/response_pane_tests.rs
