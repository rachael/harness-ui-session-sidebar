diff --git a/codex-rs/tui/src/info_pane.rs b/codex-rs/tui/src/info_pane.rs
new file mode 100644
index 0000000..eac92de
--- /dev/null
+++ b/codex-rs/tui/src/info_pane.rs
@@ -0,0 +1,675 @@
+//! Read-only native dock for the shared info-pane JSON contract.
+//! Custom sections are JSON data; the renderer never executes provider code.
+//! Sections appear first, then session details and populated content groups.
+pub(crate) mod mascot;
+
+use ratatui::buffer::Buffer;
+use ratatui::layout::Rect;
+use ratatui::style::Stylize;
+use ratatui::text::{Line, Span};
+use ratatui::widgets::{Block, Borders, Clear, Paragraph, Widget, Wrap};
+use serde_json::Value;
+use std::fs::File;
+use std::io::Read;
+use std::path::{Path, PathBuf};
+use std::time::{SystemTime, UNIX_EPOCH};
+
+pub(crate) const WIDTH: u16 = 44;
+
+pub(crate) fn pane_width(width: u16, enabled: bool) -> u16 {
+    if enabled && width >= 144 { WIDTH } else { 0 }
+}
+
+pub(crate) fn pet_fallback_area(screen: Rect, pane_enabled: bool) -> Rect {
+    Rect {
+        width: screen
+            .width
+            .saturating_sub(pane_width(screen.width, pane_enabled)),
+        ..screen
+    }
+}
+
+pub(crate) fn enabled() -> bool {
+    std::env::var("CODEX_UI_INFO_PANE").as_deref() == Ok("1")
+}
+
+fn state_directory() -> Option<PathBuf> {
+    std::env::var_os("HARNESS_UI_STATE_DIR")
+        .or_else(|| std::env::var_os("CODEX_UI_STATE_DIR"))
+        .map(PathBuf::from)
+        .or_else(|| {
+            std::env::var_os("XDG_STATE_HOME")
+                .map(PathBuf::from)
+                .or_else(|| {
+                    std::env::var_os("HOME").map(|home| PathBuf::from(home).join(".local/state"))
+                })
+                .map(|root| root.join("harness-ui-mods"))
+        })
+}
+
+fn read(path: &Path) -> Value {
+    let mut bytes = Vec::new();
+    let result = File::open(path).and_then(|file| file.take(1_048_577).read_to_end(&mut bytes));
+    if result.is_err() || bytes.len() > 1_048_576 {
+        return Value::Null;
+    }
+    let record: Value = serde_json::from_slice(&bytes).unwrap_or(Value::Null);
+    if record["schema_version"] == 1 && record["revision"].is_string() {
+        record["data"].clone()
+    } else {
+        record
+    }
+}
+
+/// Record text: control characters removed except newlines, bounded.
+fn text(value: &Value) -> String {
+    value
+        .as_str()
+        .unwrap_or("")
+        .chars()
+        .filter(|c| !c.is_control() || *c == '\n')
+        .take(8000)
+        .collect()
+}
+
+/// Section text: control characters removed and display length bounded.
+fn clean(value: &Value, length: usize) -> String {
+    value
+        .as_str()
+        .unwrap_or("")
+        .chars()
+        .filter(|c| !c.is_control())
+        .take(length)
+        .collect()
+}
+
+fn clip(value: &str, width: usize) -> String {
+    if value.chars().count() <= width {
+        value.to_owned()
+    } else {
+        let mut clipped: String = value.chars().take(width.saturating_sub(1).max(1)).collect();
+        clipped.push('…');
+        clipped
+    }
+}
+
+fn wrap(value: &str, width: usize) -> Vec<String> {
+    let wrapped: Vec<String> = textwrap::wrap(value, width.max(1))
+        .into_iter()
+        .map(|line| line.into_owned())
+        .collect();
+    if wrapped.is_empty() {
+        vec![String::new()]
+    } else {
+        wrapped
+    }
+}
+
+fn heading(lines: &mut Vec<Line<'static>>, title: String, count: Option<usize>) {
+    if !lines.is_empty() {
+        lines.push(Line::from(""));
+    }
+    let mut spans = vec![Span::from(title).bold()];
+    if let Some(count) = count {
+        spans.push(Span::from(format!(" {count}")).dim());
+    }
+    lines.push(Line::from(spans));
+}
+
+/// Providers render in key order; serde_json keeps insertion order in this crate.
+fn sections(lines: &mut Vec<Line<'static>>, sections: &Value, now_ms: f64, width: usize) {
+    let Some(providers) = sections.as_object() else {
+        return;
+    };
+    let mut keys: Vec<&String> = providers.keys().collect();
+    keys.sort();
+    for key in keys.into_iter().take(12) {
+        let section = &providers[key];
+        if !section.is_object() || section.get("visible") == Some(&Value::Bool(false)) {
+            continue;
+        }
+        let title = clean(&section["title"], 60);
+        let rows = section
+            .get("rows")
+            .cloned()
+            .unwrap_or(Value::Array(Vec::new()));
+        let Some(rows) = rows.as_array() else {
+            continue;
+        };
+        if title.is_empty() {
+            continue;
+        }
+        let icon = clean(&section["icon"], 4);
+        let title = if icon.is_empty() {
+            title
+        } else {
+            format!("{icon} {title}")
+        };
+        heading(lines, title, None);
+        for row in rows.iter().take(12) {
+            if !row.is_object() {
+                continue;
+            }
+            if let Some(expiry) = row.get("expiresAt") {
+                if expiry.as_f64().is_none_or(|expiry| expiry <= now_ms) {
+                    continue;
+                }
+            }
+            let value = clean(&row["value"], 200);
+            if value.is_empty() {
+                continue;
+            }
+            let label = clean(&row["label"], 40);
+            let row = if label.is_empty() {
+                value
+            } else {
+                format!("{label}: {value}")
+            };
+            lines.extend(wrap(&row, width).into_iter().map(Line::from));
+        }
+    }
+}
+
+fn home_relative(path: &str) -> String {
+    match std::env::var("HOME") {
+        Ok(home) if !home.is_empty() && path.starts_with(&home) => {
+            format!("~{}", &path[home.len()..])
+        }
+        _ => path.to_owned(),
+    }
+}
+
+fn surfaced_badge(record: &Value, item: &Value) -> Option<Span<'static>> {
+    if item["verified"] != true {
+        return None;
+    }
+    let provider = clean(&item["surfaced_by"], 40).to_lowercase();
+    if provider.is_empty() {
+        return None;
+    }
+    let custom = clean(&record["surface_badges"][&provider], 4);
+    let pet = text(&record["selected_pet"]);
+    let glyph = if !custom.is_empty() {
+        custom
+    } else if provider == "claude" {
+        "✦".into()
+    } else if provider == "codex" {
+        match pet.as_str() {
+            "dewey" => "D".into(),
+            "fireball" => "F".into(),
+            "rocky" => "R".into(),
+            "seedy" => "S".into(),
+            "stacky" => "S".into(),
+            "bsod" => "B".into(),
+            "null-signal" => "N".into(),
+            "" | "codex" | "disabled" => "C".into(),
+            custom => custom
+                .trim_start_matches("custom:")
+                .chars()
+                .find(|c| c.is_alphanumeric())
+                .map(|c| c.to_uppercase().collect())
+                .unwrap_or_else(|| "C".into()),
+        }
+    } else {
+        provider
+            .chars()
+            .next()
+            .map(|c| c.to_uppercase().collect())
+            .unwrap_or_else(|| "?".into())
+    };
+    let badge = Span::from(format!("[{glyph}] "));
+    Some(match pet.as_str() {
+        "fireball" => badge.red(),
+        "dewey" => badge.yellow(),
+        "seedy" => badge.green(),
+        "bsod" => badge.blue(),
+        "null-signal" => badge.magenta(),
+        _ => badge.cyan(),
+    })
+}
+
+fn surfaced(lines: &mut Vec<Line<'static>>, record: &Value, width: usize) {
+    for (title, ask) in [("Needs attention", true), ("Saved", false)] {
+        let items = record["surfaced"]
+            .as_array()
+            .into_iter()
+            .flatten()
+            .filter(|item| {
+                item["status"] != "resolved"
+                    && if ask {
+                        item["kind"] == "ask"
+                    } else {
+                        item["kind"] == "note" || item["kind"] == "decision"
+                    }
+            })
+            .filter(|item| !text(&item["text"]).trim().is_empty())
+            .collect::<Vec<_>>();
+        if items.is_empty() {
+            continue;
+        }
+        heading(lines, title.into(), Some(items.len()));
+        for item in items {
+            let mut spans = Vec::new();
+            if let Some(badge) = surfaced_badge(record, item) {
+                spans.push(badge);
+            }
+            let label = text(&item["text"])
+                .split_whitespace()
+                .collect::<Vec<_>>()
+                .join(" ");
+            spans.push(Span::from(label));
+            lines.push(
+                crate::line_truncation::truncate_line_with_ellipsis_if_overflow(
+                    Line::from(spans),
+                    width,
+                ),
+            );
+        }
+    }
+}
+
+pub(crate) fn lines(
+    record: &Value,
+    section_data: &Value,
+    now_ms: f64,
+    width: u16,
+    height: u16,
+) -> Vec<Line<'static>> {
+    let width = usize::from(width.max(1));
+    let mut lines = Vec::new();
+    surfaced(&mut lines, record, width);
+    sections(&mut lines, section_data, now_ms, width);
+
+    heading(&mut lines, "Harness".into(), None);
+    let model = text(&record["model"]);
+    let model = if model.is_empty() {
+        "…".to_owned()
+    } else {
+        model
+    };
+    lines.push(Line::from(clip(&format!("Codex · {model}"), width)));
+    let title = text(&record["title"]);
+    let title = if title.trim().is_empty() {
+        "main conversation".to_owned()
+    } else {
+        title
+    };
+    lines.push(Line::from(clip(title.trim(), width)));
+    let cwd = home_relative(&text(&record["cwd"]));
+    let branch = text(&record["branch"]);
+    let place = if branch.is_empty() {
+        cwd
+    } else {
+        format!("{cwd} ({branch})")
+    };
+    if !place.is_empty() {
+        lines.push(Line::from(clip(&place, width)).dim());
+    }
+    let recap = text(&record["recap"]);
+    if !recap.trim().is_empty() {
+        lines.extend(wrap(recap.trim(), width).into_iter().map(Line::from));
+    }
+
+    let pins: Vec<String> = record["pins"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .map(|pin| {
+            text(&pin["text"])
+                .split_whitespace()
+                .collect::<Vec<_>>()
+                .join(" ")
+        })
+        .filter(|pin| !pin.is_empty())
+        .collect();
+    if !pins.is_empty() {
+        heading(&mut lines, "Pinned".into(), Some(pins.len()));
+        lines.extend(
+            pins.iter()
+                .map(|pin| Line::from(clip(&format!("◆ {pin}"), width))),
+        );
+    }
+
+    let view = &record["views"]["main"];
+    let answer = text(&view["answer"]);
+    let answer = answer.trim();
+    if !answer.is_empty() {
+        heading(&mut lines, "Last answer".into(), None);
+        let room = usize::from(height)
+            .saturating_mul(35)
+            .div_euclid(100)
+            .max(6);
+        let wrapped: Vec<String> = answer.lines().flat_map(|line| wrap(line, width)).collect();
+        lines.extend(wrapped.iter().take(room).cloned().map(Line::from));
+        if wrapped.len() > room {
+            lines.push(Line::from(format!("  … {} more lines", wrapped.len() - room)).dim());
+        }
+    }
+
+    let asks: Vec<Line<'static>> = view["asks"]
+        .as_array()
+        .into_iter()
+        .flatten()
+        .take(8)
+        .filter_map(|ask| {
+            let summary = text(&ask["summary"]);
+            let shown = if summary.trim().is_empty() {
+                text(&ask["text"])
+            } else {
+                summary
+            };
+            let shown = shown.split_whitespace().collect::<Vec<_>>().join(" ");
+            if shown.is_empty() {
+                return None;
+            }
+            let marker = if ask["from"].as_str() == Some("agent") {
+                "◷"
+            } else {
+                "☐"
+            };
+            Some(Line::from(vec![
+                Span::from(marker).yellow(),
+                Span::from(clip(&format!(" {shown}"), width.saturating_sub(1))),
+            ]))
+        })
+        .collect();
+    if !asks.is_empty() {
+        heading(&mut lines, "Waiting on".into(), Some(asks.len()));
+        lines.extend(asks);
+    }
+
+    let tasks: Vec<&Value> = view["tasks"].as_array().into_iter().flatten().collect();
+    for (label, status) in [
+        ("In progress", "in_progress"),
+        ("Not started", "pending"),
+        ("Done", "completed"),
+    ] {
+        let group: Vec<&&Value> = tasks
+            .iter()
+            .filter(|task| task["status"].as_str() == Some(status))
+            .collect();
+        if group.is_empty() {
+            continue;
+        }
+        heading(&mut lines, label.into(), Some(group.len()));
+        let shown = if status == "completed" {
+            &group[group.len().saturating_sub(12)..]
+        } else {
+            &group[..]
+        };
+        let inner = width.saturating_sub(2);
+        for task in shown {
+            let subject = clip(&text(&task["subject"]), inner);
+            match status {
+                "in_progress" => {
+                    lines.push(Line::from(vec![
+                        Span::from("▸ ").green(),
+                        Span::from(subject),
+                    ]));
+                    let active = text(&task["active"]);
+                    let note = if active.is_empty() {
+                        text(&task["detail"])
+                    } else {
+                        active
+                    };
+                    if !note.is_empty() {
+                        lines.push(Line::from(format!("  {}", clip(&note, inner))).dim());
+                    }
+                }
+                "pending" => lines.push(Line::from(format!("○ {subject}"))),
+                _ => lines.push(Line::from(format!("✓ {subject}")).dim().crossed_out()),
+            }
+        }
+    }
+    lines
+}
+
+/// A complete native sprite request and its exclusively reserved footer region.
+#[derive(Clone)]
+pub(crate) struct PanePet {
+    pub(crate) area: Rect,
+    pub(crate) draw: crate::pets::AmbientPetDraw,
+}
+
+pub(crate) fn pet_footer_area(pane: Rect, required_height: u16) -> Option<Rect> {
+    // Keep a useful controls/content area and never partially clip a native image.
+    (pane.width >= WIDTH && pane.height >= required_height.saturating_add(12)).then(|| {
+        Rect::new(
+            pane.x + 1,
+            pane.bottom() - required_height,
+            pane.width - 1,
+            required_height,
+        )
+    })
+}
+
+pub(crate) struct Pane {
+    record: Value,
+    sections: Value,
+}
+
+impl Pane {
+    pub(crate) fn load(session: Option<String>, model: &str, cwd: &Path) -> Self {
+        let native_session = session
+            .clone()
+            .unwrap_or_else(|| format!("local-{}", std::process::id()));
+        let mut record = Value::Null;
+        let mut sections = Value::Null;
+        if let Some(session) =
+            session.filter(|s| s.chars().all(|c| c.is_ascii_alphanumeric() || c == '-'))
+        {
+            if let Some(root) = state_directory() {
+                record = read(&root.join(format!("sessions/codex/{session}.json")));
+                sections = read(&root.join(format!("sections/{session}.json")));
+            }
+        }
+        if !record.is_object() {
+            record = serde_json::json!({});
+        }
+        record["native_session"] = Value::String(native_session);
+        record["model"] = Value::String(model.to_owned());
+        record["cwd"] = Value::String(cwd.display().to_string());
+        Self { record, sections }
+    }
+
+    pub(crate) fn mascot_context(&self) -> (&str, &str, bool) {
+        (
+            self.record["native_session"].as_str().unwrap_or("local"),
+            self.record["recap"].as_str().unwrap_or(""),
+            self.record["selected_pet"]
+                .as_str()
+                .is_some_and(|value| value != "disabled"),
+        )
+    }
+
+    pub(crate) fn set_selected_pet(&mut self, pet: Option<&str>) {
+        self.record["selected_pet"] =
+            pet.map_or(Value::Null, |value| Value::String(value.to_owned()));
+    }
+
+    #[cfg(test)]
+    pub(crate) fn render(&self, area: Rect, buffer: &mut Buffer) {
+        Clear.render(area, buffer);
+        let block = Block::default().borders(Borders::LEFT).title(" Info ");
+        let inner = block.inner(area);
+        block.render(area, buffer);
+        self.render_content(inner, buffer);
+    }
+
+    pub(crate) fn render_content(&self, inner: Rect, buffer: &mut Buffer) {
+        let now = SystemTime::now()
+            .duration_since(UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_secs_f64()
+            * 1000.0;
+        Paragraph::new(lines(
+            &self.record,
+            &self.sections,
+            now,
+            inner.width,
+            inner.height,
+        ))
+        .wrap(Wrap { trim: false })
+        .render(inner, buffer);
+    }
+}
