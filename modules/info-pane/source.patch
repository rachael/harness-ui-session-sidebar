+//! Pane lists expand only through explicit controls and jump to retained native response identities.
+
+use super::*;
+use crate::history_cell::new_user_prompt;
+use crate::transcript_view::tests::cell;
+use crate::transcript_view::tests::render;
+use crate::transcript_view::tests::text;
+
+fn responses() -> Vec<Arc<dyn HistoryCell>> {
+    vec![
+        Arc::new(new_user_prompt(
+            "User prompt is not a response".into(),
+            Vec::new(),
+            Vec::new(),
+            Vec::new(),
+        )),
+        Arc::new(AgentMessageCell::new(
+            vec![
+                "First native response".into(),
+                "Extra detail for a short deterministic excerpt.".into(),
+            ],
+            true,
+        )),
+        cell("Tool output is not a response"),
+        Arc::new(AgentMessageCell::new(
+            vec!["Streaming continuation excluded".into()],
+            false,
+        )),
+        Arc::new(AgentMarkdownCell::new(
+            "Latest native response\n\nDetails from the original response, without a model call."
+                .into(),
+            std::path::Path::new("/project"),
+        )),
+    ]
+}
+
+fn paint(view: &mut TranscriptView, cells: &[Arc<dyn HistoryCell>]) -> Buffer {
+    let mut buffer = Buffer::empty(Rect::new(0, 0, 160, 20));
+    let pane =
+        crate::info_pane::Pane::load(None, "example-model", std::path::Path::new("/project"));
+    view.render_info_pane(
+        Some(&pane),
+        None,
+        Rect::new(116, 0, 44, 20),
+        &mut buffer,
+        cells,
+    );
+    buffer
+}
+
+fn click_action(
+    view: &mut TranscriptView,
+    cells: &[Arc<dyn HistoryCell>],
+    choose: impl Fn(Action) -> bool,
+) {
+    let area = view
+        .response_pane
+        .hits
+        .iter()
+        .find(|(_, action)| choose(*action))
+        .unwrap()
+        .0;
+    assert!(view.handle_info_pane_mouse(
+        MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column: area.x,
+            row: area.y,
+            modifiers: KeyModifiers::NONE
+        },
+        cells
+    ));
+}
+
+#[test]
+fn response_pane_has_native_tabs_and_no_hover_expansion() {
+    let cells = responses();
+    let mut view = TranscriptView::default();
+    let overview = paint(&mut view, &cells);
+    assert_eq!(view.response_pane.responses.len(), 2);
+    assert!(text(&overview).contains("Overview"));
+    click_action(&mut view, &cells, |action| {
+        matches!(action, Action::Responses)
+    });
+    let before = paint(&mut view, &cells);
+    assert!(text(&before).contains("Latest native response"));
+    assert!(!text(&before).contains("Tool output"));
+    for row in 0..20 {
+        view.handle_info_pane_mouse(
+            MouseEvent {
+                kind: MouseEventKind::Moved,
+                column: 118,
+                row,
+                modifiers: KeyModifiers::NONE,
+            },
+            &cells,
+        );
+    }
+    assert!(view.response_pane.expanded.is_empty());
+    assert_eq!(paint(&mut view, &cells), before);
+}
+
+#[test]
+fn response_pane_expand_preserves_transcript_then_row_click_jumps() {
+    let cells = responses();
+    let mut view = TranscriptView::default();
+    render(&mut view, &cells, 80, 8);
+    let position = view.position;
+    paint(&mut view, &cells);
+    click_action(&mut view, &cells, |action| {
+        matches!(action, Action::Responses)
+    });
+    paint(&mut view, &cells);
+    click_action(&mut view, &cells, |action| {
+        matches!(action, Action::Expand(_))
+    });
+    let expanded = paint(&mut view, &cells);
+    assert!(text(&expanded).contains("Summary:"));
+    assert_eq!(view.position, position);
+    click_action(&mut view, &cells, |action| {
+        matches!(action, Action::Jump(_))
+    });
+    assert!(
+        matches!(view.position, Position::Reading(anchor) if anchor.key == EntryKey::cell(&cells[4]))
+    );
+}
+
+#[test]
+fn response_pane_jump_survives_prepend_and_rejects_removed_target() {
+    let mut cells = responses();
+    let mut view = TranscriptView::default();
+    paint(&mut view, &cells);
+    click_action(&mut view, &cells, |action| {
+        matches!(action, Action::Responses)
+    });
+    paint(&mut view, &cells);
+    let target = EntryKey::cell(&cells[4]);
+    cells.insert(0, cell("Older paginated history"));
+    click_action(
+        &mut view,
+        &cells,
+        |action| matches!(action, Action::Jump(key) if key == target),
+    );
+    assert!(
+        matches!(view.position, Position::Reading(anchor) if anchor.key == target && anchor.index == 5)
+    );
+    view.jump_to_latest();
+    cells.pop();
+    click_action(
+        &mut view,
+        &cells,
+        |action| matches!(action, Action::Jump(key) if key == target),
+    );
+    assert_eq!(view.position, Position::Latest);
+}
+
+#[test]
+fn response_pane_scroll_and_keyboard_do_not_scroll_transcript() {
+    let cells: Vec<Arc<dyn HistoryCell>> = (0..40)
+        .map(|index| {
+            Arc::new(AgentMessageCell::new(
+                vec![format!("Response {index}").into()],
+                true,
+            )) as Arc<dyn HistoryCell>
+        })
+        .collect();
+    let mut view = TranscriptView::default();
+    render(&mut view, &cells, 80, 8);
+    let position = view.position;
+    paint(&mut view, &cells);
+    let key = |code| KeyEvent::new(code, KeyModifiers::NONE);
+    view.handle_key(key(KeyCode::F(6)), &cells);
+    paint(&mut view, &cells);
+    for _ in 0..40 {
+        view.handle_info_pane_mouse(
+            MouseEvent {
+                kind: MouseEventKind::ScrollDown,
+                column: 120,
+                row: 8,
+                modifiers: KeyModifiers::NONE,
+            },
+            &cells,
+        );
+    }
+    assert!(view.response_pane.offset > 0);
+    assert_eq!(view.position, position);
+    view.handle_key(key(KeyCode::Char(' ')), &cells);
+    assert_eq!(view.response_pane.expanded.len(), 1);
+    view.handle_key(key(KeyCode::Enter), &cells);
+    assert!(
+        matches!(view.position, Position::Reading(anchor) if anchor.key == EntryKey::cell(&cells[39]))
+    );
+}
+
+#[test]
+fn response_pane_hides_without_keyboard_capture_and_stays_inside_dock() {
+    let cells = responses();
+    let mut view = TranscriptView::default();
+    let mut buffer = Buffer::empty(Rect::new(0, 0, 160, 20));
+    Line::from("Composer draft selection sentinel").render(Rect::new(0, 18, 116, 1), &mut buffer);
+    let before = buffer.clone();
+    let pane =
+        crate::info_pane::Pane::load(None, "example-model", std::path::Path::new("/project"));
+    view.render_info_pane(
+        Some(&pane),
+        None,
+        Rect::new(116, 0, 44, 20),
+        &mut buffer,
+        &cells,
+    );
+    for y in 0..20 {
+        for x in 0..116 {
+            assert_eq!(buffer[(x, y)], before[(x, y)]);
+        }
+    }
+    view.render_info_pane(None, None, Rect::default(), &mut buffer, &cells);
+    assert!(!view.response_pane_owns_key(KeyEvent::new(KeyCode::F(6), KeyModifiers::NONE)));
+    assert!(!view.handle_info_pane_mouse(
+        MouseEvent {
+            kind: MouseEventKind::Down(MouseButton::Left),
+            column: 120,
+            row: 3,
+            modifiers: KeyModifiers::NONE
+        },
+        &cells
+    ));
+}
+
+#[test]
+fn response_pane_pet_footer_never_covers_response_controls() {
+    let cells = responses();
+    let mut view = TranscriptView::default();
+    let pane_area = Rect::new(116, 0, 44, 30);
+    let area = crate::info_pane::pet_footer_area(pane_area, 8).unwrap();
+    let draw = crate::pets::AmbientPetDraw {
+        frame: "fictional-frame.png".into(),
+        protocol: crate::pets::ImageProtocol::Kitty,
+        x: 150,
+        y: 24,
+        clear_top_y: area.y,
+        columns: 9,
+        rows: 5,
+        height_px: 75,
+        sixel_dir: "fictional-frames".into(),
+    };
+    let pane =
+        crate::info_pane::Pane::load(None, "example-model", std::path::Path::new("/project"));
+    let mut buffer = Buffer::empty(Rect::new(0, 0, 160, 30));
+    view.render_info_pane(
+        Some(&pane),
+        Some(crate::info_pane::PanePet { area, draw }),
+        pane_area,
+        &mut buffer,
+        &cells,
+    );
+    assert!(
+        view.response_pane
+            .hits
+            .iter()
+            .all(|(hit, _)| hit.bottom() <= area.y)
+    );
+    assert!(view.info_pane_pet_draw().is_some());
+    view.render_info_pane(None, None, Rect::default(), &mut buffer, &cells);
+    assert!(view.info_pane_pet_draw().is_none());
+}
