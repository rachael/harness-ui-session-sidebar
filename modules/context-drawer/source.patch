+// Modified: add an optional in-place context drawer (2026-10-26).
+//! Inspect pinned context without moving the transcript, composer, or selection.
+//!
+//! The drawer is an overlay over already-painted transcript rows. Its scroll offset and
+//! one-cell layout cache are independent of transcript navigation and source-based copying.
+
+use super::*;
+use crossterm::event::KeyCode;
+use crossterm::event::KeyEvent;
+use crossterm::event::KeyModifiers;
+use crossterm::event::MouseButton;
+use crossterm::event::MouseEvent;
+use crossterm::event::MouseEventKind;
+use ratatui::layout::Position as ScreenPosition;
+
+#[derive(Default)]
+pub(super) struct ContextDrawer {
+    target: Option<EntryKey>,
+    keyboard: bool,
+    offset: usize,
+    area: Option<Rect>,
+    layout: Option<(EntryKey, u16, TextLayout)>,
+}
+
+impl ContextDrawer {
+    pub(super) fn is_open(&self) -> bool {
+        self.target.is_some()
+    }
+
+    fn open(&mut self, key: EntryKey, keyboard: bool) {
+        if self.target != Some(key) {
+            self.offset = 0;
+        }
+        self.target = Some(key);
+        self.keyboard = keyboard;
+    }
+
+    pub(super) fn obscures(&self, area: Rect) -> bool {
+        self.area
+            .is_some_and(|drawer| !drawer.intersection(area).is_empty())
+    }
+
+    fn contains(&self, column: u16, row: u16) -> bool {
+        self.area
+            .is_some_and(|area| area.contains(ScreenPosition::new(column, row)))
+    }
+
+    fn scroll(&mut self, rows: isize) {
+        let count = self
+            .layout
+            .as_ref()
+            .map_or(0, |(_, _, layout)| layout.row_count());
+        let page = self
+            .area
+            .map_or(0, |area| usize::from(area.height.saturating_sub(2)));
+        self.offset = self
+            .offset
+            .saturating_add_signed(rows)
+            .min(count.saturating_sub(page));
+    }
+}
+
+impl TranscriptView {
+    pub(crate) fn close_context_drawer(&mut self) -> bool {
+        let open = self.context_drawer.is_open();
+        self.context_drawer = ContextDrawer::default();
+        open
+    }
+
+    /// Composer events can be handled before transcript mouse input. Observe leaving here too.
+    pub(crate) fn dismiss_context_drawer_outside(&mut self, event: MouseEvent) -> bool {
+        if self.context_drawer.is_open()
+            && !self.context_drawer.keyboard
+            && !self.context_drawer.contains(event.column, event.row)
+            && !self.prompt_header_target.is_some_and(|(area, _)| {
+                area.contains(ScreenPosition::new(event.column, event.row))
+            })
+        {
+            return self.close_context_drawer();
+        }
+        false
+    }
+
+    pub(super) fn render_context_drawer(
+        &mut self,
+        viewport: Rect,
+        cells: &[Arc<dyn HistoryCell>],
+        buf: &mut Buffer,
+    ) {
+        if !self.context_drawer_enabled {
+            return;
+        }
+        let Some((header, key)) = self.prompt_header_target else {
+            self.close_context_drawer();
+            return;
+        };
+        if self.context_drawer.target != Some(key) || viewport.height < 4 {
+            self.close_context_drawer();
+            return;
+        }
+        let drawer = &mut self.context_drawer;
+        if drawer
+            .layout
+            .as_ref()
+            .is_none_or(|(cached, width, _)| *cached != key || *width != header.width)
+        {
+            let Some(cell) = cells.iter().find(|cell| EntryKey::cell(cell) == key) else {
+                self.close_context_drawer();
+                return;
+            };
+            drawer.layout = Some((
+                key,
+                header.width,
+                TextLayout::new(cell.transcript_hyperlink_lines(header.width), header.width),
+            ));
+        }
+        let Some((_, _, layout)) = &drawer.layout else {
+            return;
+        };
+        // Keep the composer and one underlying transcript row visible. No transcript geometry changes.
+        let height = layout
+            .row_count()
+            .saturating_add(2)
+            .min(usize::from(viewport.height.saturating_sub(1))) as u16;
+        let area = Rect::new(header.x, header.y, header.width, height);
+        let page = usize::from(height.saturating_sub(2));
+        drawer.offset = drawer.offset.min(layout.row_count().saturating_sub(page));
+        drawer.area = Some(area);
+        let body = Rect::new(area.x, area.y + 1, area.width, height.saturating_sub(2));
+        Clear.render(body, buf);
+        layout.render(body, buf, drawer.offset);
+        let footer = Rect::new(area.x, area.bottom() - 1, area.width, 1);
+        Clear.render(footer, buf);
+        let hint = format!(
+            "{}–{}/{} · wheel/↑↓ · enter jump · esc close",
+            drawer.offset + 1,
+            (drawer.offset + page).min(layout.row_count()),
+            layout.row_count()
+        );
+        crate::line_truncation::truncate_line_with_ellipsis_if_overflow(
+            Line::from(hint).dim(),
+            usize::from(area.width),
+        )
+        .render(footer, buf);
+    }
+
+    pub(super) fn context_drawer_owns_key(&self, key: KeyEvent) -> bool {
+        self.context_drawer_enabled
+            && key.modifiers.is_empty()
+            && (key.code == KeyCode::F(5) && self.prompt_header_target.is_some()
+                || self.context_drawer.is_open()
+                    && matches!(
+                        key.code,
+                        KeyCode::Esc
+                            | KeyCode::Enter
+                            | KeyCode::Up
+                            | KeyCode::Down
+                            | KeyCode::PageUp
+                            | KeyCode::PageDown
+                            | KeyCode::Home
+                            | KeyCode::End
+                    ))
+    }
+
+    pub(super) fn handle_context_drawer_key(
+        &mut self,
+        key: KeyEvent,
+        cells: &[Arc<dyn HistoryCell>],
+    ) -> Option<ViewAction> {
+        if !self.context_drawer_enabled {
+            return None;
+        }
+        if key.modifiers == KeyModifiers::NONE && key.code == KeyCode::F(5) {
+            if self.context_drawer.is_open() {
+                self.close_context_drawer();
+            } else if let Some((_, target)) = self.prompt_header_target {
+                self.context_drawer.open(target, true);
+            } else {
+                return None;
+            }
+            return Some(ViewAction::Changed);
+        }
+        if !self.context_drawer.is_open() {
+            return None;
+        }
+        if !self.context_drawer_owns_key(key) {
+            self.close_context_drawer();
+            return None;
+        }
+        let page = self
+            .context_drawer
+            .area
+            .map_or(1, |area| (area.height.saturating_sub(2) as isize).max(1));
+        match key.code {
+            KeyCode::Esc => {
+                self.close_context_drawer();
+            }
+            KeyCode::Enter => self.jump_to_context_drawer(cells),
+            KeyCode::Up => self.context_drawer.scroll(-1),
+            KeyCode::Down => self.context_drawer.scroll(1),
+            KeyCode::PageUp => self.context_drawer.scroll(-page),
+            KeyCode::PageDown => self.context_drawer.scroll(page),
+            KeyCode::Home => self.context_drawer.offset = 0,
+            KeyCode::End => self.context_drawer.scroll(isize::MAX),
+            _ => return None,
+        }
+        Some(ViewAction::Changed)
+    }
+
+    fn jump_to_context_drawer(&mut self, cells: &[Arc<dyn HistoryCell>]) {
+        let target = self.context_drawer.target;
+        self.close_context_drawer();
+        if let Some(index) = cells
+            .iter()
+            .position(|cell| Some(EntryKey::cell(cell)) == target)
+        {
+            self.end_selection(cells);
+            self.cancel_search();
+            self.clear_activity_focus();
+            self.jump_to_entry(cells, index);
+        }
+    }
+
+    pub(super) fn handle_context_drawer_mouse(
+        &mut self,
+        event: MouseEvent,
+        cells: &[Arc<dyn HistoryCell>],
+    ) -> Option<ViewAction> {
+        if !self.context_drawer_enabled { return None; }
+        let header = self
+            .prompt_header_target
+            .filter(|(area, _)| area.contains(ScreenPosition::new(event.column, event.row)));
+        if event.kind == MouseEventKind::Moved
+            && header.is_some()
+            && !self
+                .selection
+                .as_ref()
+                .is_some_and(|selection| selection.dragging)
+        {
+            let (_, target) = header?;
+            if self.context_drawer.target != Some(target) {
+                self.context_drawer.open(target, false);
+                // Use the header before the first expanded frame has established its full area.
+                self.context_drawer.area = header.map(|(area, _)| area);
+                return Some(ViewAction::Changed);
+            }
+        }
+        if self.dismiss_context_drawer_outside(event) {
+            return Some(ViewAction::Changed);
+        }
+        if !self.context_drawer.is_open() || !self.context_drawer.contains(event.column, event.row)
+        {
+            return None;
+        }
+        match event.kind {
+            MouseEventKind::ScrollUp => self.context_drawer.scroll(-3),
+            MouseEventKind::ScrollDown => self.context_drawer.scroll(3),
+            MouseEventKind::Down(MouseButton::Left) if event.modifiers.is_empty() => {
+                self.last_click = None;
+                self.jump_to_context_drawer(cells);
+            }
+            _ => {}
+        }
+        // Never leak a gesture through the overlay into hidden text selection or scrolling.
+        Some(ViewAction::Changed)
+    }
+}
+
+#[cfg(test)]
+#[path = "context_drawer_tests.rs"]
+mod tests;
