@@ -0,0 +1,283 @@
+//! Drawer interactions are presentation-only until explicit navigation.
+
+use super::*;
+use crate::history_cell::new_user_prompt;
+use crate::transcript_view::tests::cell;
+use crate::transcript_view::tests::render;
+use crate::transcript_view::tests::text;
+
+fn conversation() -> Vec<Arc<dyn HistoryCell>> {
+    vec![
+        Arc::new(new_user_prompt(
+            (0..80)
+                .map(|row| format!("complete prompt line {row:02}\n"))
+                .collect(),
+            Vec::new(),
+            Vec::new(),
+            Vec::new(),
+        )),
+        cell(
+            (0..60)
+                .map(|row| format!("answer {row}\n"))
+                .collect::<String>(),
+        ),
+    ]
+}
+
+fn mouse(kind: MouseEventKind, row: u16) -> MouseEvent {
+    MouseEvent {
+        kind,
+        column: 2,
+        row,
+        modifiers: KeyModifiers::NONE,
+    }
+}
+
+#[test]
+fn hover_and_leave_preserve_viewport_and_selection() {
+    let cells = conversation();
+    let mut view = TranscriptView::default();
+    view.context_drawer_enabled = true;
+    render(&mut view, &cells, 40, 12);
+    view.handle_mouse(mouse(MouseEventKind::Down(MouseButton::Left), 7), &cells);
+    view.handle_mouse(
+        MouseEvent {
+            column: 8,
+            ..mouse(MouseEventKind::Drag(MouseButton::Left), 7)
+        },
+        &cells,
+    );
+    view.handle_mouse(
+        MouseEvent {
+            column: 8,
+            ..mouse(MouseEventKind::Up(MouseButton::Left), 7)
+        },
+        &cells,
+    );
+    let before = render(&mut view, &cells, 40, 12);
+    let position = view.position;
+    let area = view.area;
+    let selection = view.selected_text(&cells);
+    let rows = view
+        .visible
+        .iter()
+        .map(|row| (row.index, row.row, row.key))
+        .collect::<Vec<_>>();
+    assert!(selection.is_some());
+
+    assert!(
+        view.handle_mouse(mouse(MouseEventKind::Moved, 0), &cells)
+            .is_some()
+    );
+    let expanded = render(&mut view, &cells, 40, 12);
+    assert_ne!(text(&expanded), text(&before));
+    assert_eq!(view.position, position);
+    assert_eq!(view.area, area);
+    assert_eq!(view.selected_text(&cells), selection);
+    assert_eq!(
+        view.visible
+            .iter()
+            .map(|row| (row.index, row.row, row.key))
+            .collect::<Vec<_>>(),
+        rows
+    );
+    assert!(view.dismiss_context_drawer_outside(mouse(MouseEventKind::Moved, 20)));
+    assert_eq!(render(&mut view, &cells, 40, 12), before);
+    assert_eq!(view.selected_text(&cells), selection);
+}
+
+#[test]
+fn wheel_reads_entire_long_prompt_without_scrolling_transcript() {
+    let cells = conversation();
+    let mut view = TranscriptView::default();
+    view.context_drawer_enabled = true;
+    render(&mut view, &cells, 40, 12);
+    let position = view.position;
+    let visible = view
+        .visible
+        .iter()
+        .map(|row| (row.index, row.row))
+        .collect::<Vec<_>>();
+    view.handle_mouse(mouse(MouseEventKind::Moved, 0), &cells);
+    render(&mut view, &cells, 40, 12);
+    for _ in 0..100 {
+        view.handle_mouse(mouse(MouseEventKind::ScrollDown, 2), &cells);
+        render(&mut view, &cells, 40, 12);
+    }
+    let bottom = render(&mut view, &cells, 40, 12);
+    assert!(text(&bottom).contains("complete prompt line 79"));
+    assert_eq!(view.position, position);
+    assert_eq!(
+        view.visible
+            .iter()
+            .map(|row| (row.index, row.row))
+            .collect::<Vec<_>>(),
+        visible
+    );
+    for _ in 0..100 {
+        view.handle_mouse(mouse(MouseEventKind::ScrollUp, 2), &cells);
+    }
+    assert!(text(&render(&mut view, &cells, 40, 12)).contains("complete prompt line 00"));
+    assert_eq!(view.position, position);
+}
+
+#[test]
+fn click_navigates_to_source_and_collapses() {
+    let cells = conversation();
+    let mut view = TranscriptView::default();
+    view.context_drawer_enabled = true;
+    render(&mut view, &cells, 40, 12);
+    view.handle_mouse(mouse(MouseEventKind::Moved, 0), &cells);
+    render(&mut view, &cells, 40, 12);
+    view.handle_mouse(mouse(MouseEventKind::Down(MouseButton::Left), 2), &cells);
+    assert!(!view.context_drawer.is_open());
+    assert!(
+        matches!(view.position, Position::Reading(anchor) if anchor.key == EntryKey::cell(&cells[0]))
+    );
+    let shown = text(&render(&mut view, &cells, 40, 12));
+    assert!(shown.contains("complete prompt line 00"));
+}
+
+#[test]
+fn keyboard_fallback_scrolls_and_returns_without_changing_position() {
+    let cells = conversation();
+    let mut view = TranscriptView::default();
+    view.context_drawer_enabled = true;
+    let before = render(&mut view, &cells, 40, 12);
+    let position = view.position;
+    let key = |code| KeyEvent::new(code, KeyModifiers::NONE);
+    assert!(view.owns_interaction_key(key(KeyCode::F(5))));
+    view.handle_key(key(KeyCode::F(5)), &cells);
+    render(&mut view, &cells, 40, 12);
+    view.handle_key(key(KeyCode::End), &cells);
+    assert!(text(&render(&mut view, &cells, 40, 12)).contains("complete prompt line 79"));
+    view.handle_key(key(KeyCode::Home), &cells);
+    assert!(text(&render(&mut view, &cells, 40, 12)).contains("complete prompt line 00"));
+    view.handle_key(key(KeyCode::Esc), &cells);
+    assert_eq!(view.position, position);
+    assert_eq!(render(&mut view, &cells, 40, 12), before);
+    view.handle_key(key(KeyCode::F(5)), &cells);
+    render(&mut view, &cells, 40, 12);
+    view.handle_key(key(KeyCode::Enter), &cells);
+    assert!(
+        matches!(view.position, Position::Reading(anchor) if anchor.key == EntryKey::cell(&cells[0]))
+    );
+}
+
+#[test]
+fn narrow_resize_and_typing_dismiss_without_consuming_composer_input() {
+    let cells = conversation();
+    let mut view = TranscriptView::default();
+    view.context_drawer_enabled = true;
+    render(&mut view, &cells, 16, 5);
+    view.handle_key(KeyEvent::new(KeyCode::F(5), KeyModifiers::NONE), &cells);
+    render(&mut view, &cells, 16, 5);
+    assert!(view.context_drawer.is_open());
+    assert!(
+        view.handle_key(
+            KeyEvent::new(KeyCode::Char('x'), KeyModifiers::NONE),
+            &cells
+        )
+        .is_none()
+    );
+    assert!(!view.context_drawer.is_open());
+    view.handle_key(KeyEvent::new(KeyCode::F(5), KeyModifiers::NONE), &cells);
+    render(&mut view, &cells, 15, 3);
+    assert!(!view.context_drawer.is_open());
+    assert!(
+        view.handle_key(KeyEvent::new(KeyCode::F(5), KeyModifiers::NONE), &cells)
+            .is_none()
+    );
+}
+
+#[test]
+fn drawer_paints_only_inside_transcript_not_composer_sentinel() {
+    let cells = conversation();
+    let mut view = TranscriptView::default();
+    view.context_drawer_enabled = true;
+    let viewport = Rect::new(0, 0, 40, 12);
+    let mut buffer = Buffer::empty(Rect::new(0, 0, 40, 16));
+    Line::from("composer draft and selection").render(Rect::new(0, 13, 40, 1), &mut buffer);
+    view.render(viewport, &mut buffer, &cells);
+    let composer = buffer.content[40 * 12..].to_vec();
+    view.handle_mouse(mouse(MouseEventKind::Moved, 0), &cells);
+    view.render(viewport, &mut buffer, &cells);
+    assert_eq!(buffer.content[40 * 12..], composer);
+}
+
+#[test]
+fn disabled_module_keeps_stock_header_and_interactions() {
+    let cells = conversation();
+    let mut stock = TranscriptView::default();
+    stock.context_drawer_enabled = false;
+    let before = render(&mut stock, &cells, 40, 12);
+    // Upstream's follow control may request a frame on pointer motion even with no drawer.
+    let position = stock.position;
+    stock.handle_mouse(mouse(MouseEventKind::Moved, 0), &cells);
+    assert_eq!(stock.position, position);
+    assert!(
+        stock
+            .handle_key(KeyEvent::new(KeyCode::F(5), KeyModifiers::NONE), &cells)
+            .is_none()
+    );
+    assert!(!stock.context_drawer.is_open());
+    assert_eq!(render(&mut stock, &cells, 40, 12), before);
+    stock.handle_mouse(mouse(MouseEventKind::Down(MouseButton::Left), 0), &cells);
+    assert!(
+        matches!(stock.position, Position::Reading(anchor) if anchor.key == EntryKey::cell(&cells[0]))
+    );
+}
+
+/// Export actual ratatui buffers when requested; no desktop or fabricated screenshot involved.
+#[test]
+fn context_drawer_capture_views() {
+    let prompt = std::env::var_os("CODEX_DRAWER_CAPTURE_PROMPT_FILE")
+        .map(|path| std::fs::read_to_string(path).expect("read explicit capture prompt"))
+        .unwrap_or_else(|| "Please compare the fictional orchard designs and show how the gate, path, and planting beds fit together.\n\nKeep the long original request available while reading the answer, without moving the composer or leaving the current reading position. Include the complete fictional design constraints in the context preview.".to_owned());
+    let cells: Vec<Arc<dyn HistoryCell>> = vec![
+        Arc::new(new_user_prompt(
+            prompt.into(),
+            Vec::new(),
+            Vec::new(),
+            Vec::new(),
+        )),
+        cell(
+            (0..35)
+                .map(|_| "The answer remains in the transcript below the pinned prompt.\n")
+                .collect::<String>(),
+        ),
+    ];
+    let mut view = TranscriptView::default();
+    view.context_drawer_enabled = true;
+    let viewport = Rect::new(0, 0, 80, 20);
+    let mut collapsed = Buffer::empty(Rect::new(0, 0, 80, 24));
+    Line::from("› Composer stays in place").render(Rect::new(0, 21, 80, 1), &mut collapsed);
+    view.render(viewport, &mut collapsed, &cells);
+    view.handle_mouse(mouse(MouseEventKind::Moved, 0), &cells);
+    let mut expanded = collapsed.clone();
+    view.render(viewport, &mut expanded, &cells);
+    assert_ne!(text(&collapsed), text(&expanded));
+    assert_eq!(collapsed.content[80 * 20..], expanded.content[80 * 20..]);
+    assert!(view.context_drawer.is_open());
+    if let Some(directory) = std::env::var_os("CODEX_DRAWER_CAPTURE_DIR") {
+        let directory = std::path::PathBuf::from(directory);
+        std::fs::create_dir_all(&directory).unwrap();
+        for (name, buffer) in [("collapsed", collapsed), ("expanded", expanded)] {
+            let capture = serde_json::json!({
+                "source": "Codex 0.164.0 ratatui renderer fixture; not a desktop screenshot",
+                "width": buffer.area.width, "height": buffer.area.height,
+                "text": text(&buffer),
+                "cells": buffer.content.iter().enumerate().map(|(index, cell)| serde_json::json!({
+                    "x": index % 80, "y": index / 80, "symbol": cell.symbol(),
+                    "fg": format!("{:?}", cell.fg), "bg": format!("{:?}", cell.bg),
+                    "modifiers": format!("{:?}", cell.modifier),
+                })).collect::<Vec<_>>(),
+            });
+            std::fs::write(
+                directory.join(format!("{name}.json")),
+                serde_json::to_vec_pretty(&capture).unwrap(),
+            )
+            .unwrap();
+        }
+    }
+}
